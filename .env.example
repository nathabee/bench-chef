# Observer : BenchChef with promotheus and grafana
# These values are port to access docker services :
PROMETHEUS_PORT=18073
GRAFANA_PORT=18074
NODE_EXPORTER_PORT=18075
PROCESS_EXPORTER_PORT=18076

BENCHCHEF_DEBUG=true
# Django backend  
BENCHCHEF_BACKEND_PORT=18071
# Angular frontend  
BENCHCHEF_FRONTEND_PORT=18072
# Optional background diagnostics loop for Grafana sample generation.
# Angular can launch probes manually, so this is disabled by default.
BENCHCHEF_START_DIAGNOSTICS_LOOP=false
BENCHCHEF_DIAGNOSTICS_CONNECTION_ID=1
BENCHCHEF_DIAGNOSTICS_INTERVAL_SECONDS=5

# observed program : SpaghettiChef
# BenchChef checks this URL but does not start SpaghettiChef.
SPAGHETTICHEF_BASE_URL=http://localhost:18080
SPAGHETTICHEF_ROLE_HEADER=ADMIN
